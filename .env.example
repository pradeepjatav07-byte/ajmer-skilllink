# DEVELOPMENT ONLY EXAMPLE — copy to .env and replace every placeholder.
# Never commit .env or reuse these values in production.
MYSQL_DATABASE=ajmer_skilllink
MYSQL_USER=skilllink
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

DB_URL=jdbc:mysql://localhost:3306/ajmer_skilllink?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=skilllink
DB_PASSWORD=change-me-local-only
SERVER_PORT=8080

# Generate a random 32-byte Base64 key, for example with scripts/dev-env.ps1.
SKILLLINK_JWT_SECRET_BASE64=replace-with-random-32-byte-base64
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
